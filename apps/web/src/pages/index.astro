---
import '../styles/global.css';
import { createInitialModeExpression } from 'mode-watcher';
import MagnetFlow from '../lib/components/magnet-flow.svelte';

/** BASE_URL with exactly one trailing slash ("/" at the root of the site). */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- The ICO first, with its size: otherwise Chrome picks it over the SVG. -->
		<link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Magnet Watcher</title>
		<script is:inline set:html={createInitialModeExpression()} />
		<!--
			The streaming service worker (src/lib/stream/sw.ts): serves
			/stream/<info-hash>/<file> with range support from the files this
			page has open, so MP4 and WebM play in a native <video>. Isolation
			(COOP/COEP) comes from the server: public/_headers on Pages, the dev
			server's headers in development. Registering it at the root also
			replaces the old isolation worker (coi-sw.js) where it is installed.
		-->
		<script is:inline define:vars={{ worker: `${base}stream-sw.js`, scope: base }}>
			if (window.isSecureContext && "serviceWorker" in navigator) {
				navigator.serviceWorker.register(worker, { scope }).catch(() => {});
			}
		</script>
	</head>
	<body>
		<MagnetFlow client:load />
	</body>
</html>
