# Copy to /etc/magnet-seeders/magnet-seeders.env and adjust.
# See the README's Configuration table for the full list and defaults.

# Only nginx (on the same host) should reach this port; keep it on
# loopback and let nginx do TLS + the public subdomain.
BIND_ADDR=127.0.0.1:8080

# UDP port for the DHT node. Must be free; no need to open it in the
# firewall for outbound lookups to work (see README), but you can if you
# want this node to fully participate in the DHT.
DHT_PORT=6881

# Tunnel inbound peers (README › Configuration): TCP and UDP (uTP) on the
# same port, which must differ from DHT_PORT (both need UDP). Unset: off.
# TUNNEL_INBOUND_ADDR=0.0.0.0:6883

CACHE_TTL_SECS=300
EMPTY_CACHE_TTL_SECS=30
DEADLINE_MS=3000

# Comma-separated list of sites allowed to call this API from browser JS,
# or `*` for any site. Required for CORS to work at all.
ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Streamed /peers (docs/discovery-api.md): stream length and abuse limits.
PEERS_STREAM_SECS=30
PEERS_PER_IP_PER_MINUTE=30
PEERS_STREAMS_PER_IP=4
PEERS_STREAMS_TOTAL=200
# Header nginx sets with the client IP (trusted only from loopback).
CLIENT_IP_HEADER=X-Real-IP

# Shared with magnet-worker (`npx wrangler secret put TOKEN_SECRET` there):
# /swarm signs a token per peer with it, and the worker only connects to
# peers carrying a valid one. Generate with `openssl rand -base64 32`.
# WORKER_TOKEN_SECRET=

# Swarm probing / refresh (see README for all knobs).
PROBE_CONCURRENCY=256
REFRESH_INTERVAL_SECS=300

RUST_LOG=info
