# Copy to /etc/magnet-stream/magnet-stream.env and adjust (placeholders only).
# The "magnet-stream" install runs next to the PoC's magnet-seeders: its
# HTTP port and DHT port must differ from the PoC's and from any other
# service on the host. Check what is taken with `sudo ss -lntup`.

# Loopback only: nginx (same host) does TLS and the public subdomain.
BIND_ADDR=127.0.0.1:8096

# UDP port of this service's own DHT node (the PoC's uses 6881).
DHT_PORT=6882

# The site's origin(s), comma-separated: the only pages allowed to call
# /peers from the browser (CORS, decision OQ-09). Example:
# ALLOWED_ORIGINS=https://magnet-stream.pages.dev
ALLOWED_ORIGINS=https://your-site.pages.dev

# Streamed /peers (docs/discovery-api.md): stream length and abuse limits
# (OQ-14 defaults).
PEERS_STREAM_SECS=30
PEERS_PER_IP_PER_MINUTE=30
PEERS_STREAMS_PER_IP=4
PEERS_STREAMS_TOTAL=200
# Header nginx sets with the client IP (trusted only from loopback).
CLIENT_IP_HEADER=X-Real-IP

CACHE_TTL_SECS=300
EMPTY_CACHE_TTL_SECS=30

# No WORKER_TOKEN_SECRET: the monorepo's gateway does not use peer tokens.

RUST_LOG=info

# Scouting and memory budgets (docs/discovery-api.md, decision OQ-22).
# Caches are in memory only and weighed in bytes; size them to the host.
PROBE_CONCURRENCY=256
SCOUT_PER_STREAM=64
SCOUT_CACHE_MB=16
PEERS_CACHE_MB=16
# Info dicts: cache budget, largest entry cached, fetches in flight, deadline.
METADATA_CACHE_MB=32
METADATA_CACHE_MAX_ENTRY_MB=4
METADATA_FETCHES=4
METADATA_DEADLINE_MS=15000

# Tunnel gateway GET /v1/tunnel (docs/tunnel-protocol.md): the fallback
# data path, same protocol and limits as the Cloudflare gateway. The Origin
# check uses ALLOWED_ORIGINS above (403 before the upgrade). No secret.
# (nginx must forward WebSocket upgrades on /v1/tunnel: M5-04.)
TUNNEL_CONNECT_TIMEOUT_MS=5000
TUNNEL_HANDSHAKE_TIMEOUT_MS=10000
TUNNEL_MAX_CONNECTIONS=6
TUNNEL_IDLE_TIMEOUT_MS=90000
TUNNEL_SESSION_TIMEOUT_S=7200
TUNNEL_SOCKETS_PER_SESSION=3
TUNNEL_UPGRADES_PER_MINUTE=30
TUNNEL_MAX_PENDING_WRITE_BYTES=4194304
# Concurrent WebSockets per client IP and in total (bounds the peer sockets).
TUNNEL_SOCKETS_PER_IP=12
TUNNEL_MAX_SOCKETS=256

# Announce and inbound peers (docs/tunnel-protocol.md › Announce and inbound
# connections, M4-02): only while a session asks. The same port number takes
# TCP and UDP (uTP, M4-04e): open both in the firewall. It must be >= 1024
# (the service is not root), free on the host for TCP and UDP (the PoC's
# magnet-seeders uses UDP 6881 for its DHT) and different from DHT_PORT
# above (on a clash inbound peers are turned off).
# Unset TUNNEL_INBOUND_ADDR to disable (sessions get "unsupported").
TUNNEL_INBOUND_ADDR=0.0.0.0:6883
# TUNNEL_ANNOUNCE_PORT=0
TUNNEL_ANNOUNCE_INTERVAL_S=900
TUNNEL_ANNOUNCE_DHT=1
TUNNEL_INBOUND_PER_SESSION=16
TUNNEL_INBOUND_MAX=256
TUNNEL_INBOUND_PENDING=64
TUNNEL_ANNOUNCES_PER_SOCKET=2
TUNNEL_ANNOUNCES_MAX=64
# Per client IP (an IPv6 /64): info-hashes at once, and announce rounds
# (a new swarm, or trackers added to one) per minute; and rounds per minute
# for the whole gateway. They keep a client that cycles announce/withdraw
# from turning the gateway into a source of tracker and DHT traffic.
TUNNEL_ANNOUNCES_PER_IP=4
TUNNEL_ANNOUNCE_ROUNDS_PER_IP_PER_MINUTE=6
TUNNEL_ANNOUNCE_ROUNDS_PER_MINUTE=60
